# ==============================================================================
# TRIMZ SALON — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection (Supabase Transaction Pooler or Direct Connection)
# Note: If your password contains special characters (e.g. '@', ':', '%'), URL-encode them (e.g. '@' -> '%40')
# Format: postgresql+asyncpg://postgres.yourproject:encoded_password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trimz_salon_db

# Security & Authentication
JWT_SECRET=generate-a-secure-64-character-random-hex-string-for-trimz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://trimz-salon.vercel.app

# File Storage & Server URL
STORAGE_DIR=storage
BASE_URL=http://127.0.0.1:8000

# Meta WhatsApp Cloud API Configuration
META_WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
META_WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_account_id
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_secret_token
META_WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac_sha256
META_WHATSAPP_API_VERSION=v20.0

