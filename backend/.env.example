# ==============================================================================
# TRIMZ SALON — BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Connection (Supabase Transaction Pooler or Direct Connection)
# Format: postgresql+asyncpg://postgres.yourproject:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trimz_salon_db

# Security & Authentication
JWT_SECRET=generate-a-secure-64-character-random-hex-string-for-trimz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
